// .env.example
DATABASE_URL="postgresql://user:password@host/database"
PORT=3000

# Uploadcare: chave pública ilustrativa, não coloque credenciais reais aqui.
UPLOADCARE_PUBLIC_KEY=your_public_key

# ADICIONADO (aula 11): autenticação JWT. Gere um segredo próprio (mínimo 32 caracteres) e nunca o versione.
JWT_SECRET="gere-com-node-crypto-randomBytes-64-hex"
JWT_EXPIRES_IN="1h"
BCRYPT_SALT_ROUNDS=10
# ADICIONADO (aula 11): CORS, origens de frontends autorizadas, separadas por vírgula.
CORS_ORIGINS="http://localhost:5173"
